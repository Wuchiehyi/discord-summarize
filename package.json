{
  "name": "discord-summarize",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "把 Discord 頻道一段時間內的訊息摘要成繁體中文",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "predeploy": "npm run build",
    "deploy": "node dist/deploy-commands.js",
    "check": "tsc --noEmit",
    "test": "tsc && node dist/summarize.test.js"
  },
  "dependencies": {
    "discord.js": "^14.22.1",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
